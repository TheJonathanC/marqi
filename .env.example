# Copy to .env.local for development. In production, set these in Vercel.

# Postgres connection string (Neon via the Vercel Marketplace works well).
# Leave unset in development to use an embedded PGlite database in .data/.
DATABASE_URL=

# At least 32 random characters: `openssl rand -base64 32`
SESSION_SECRET=

# GitHub OAuth app (https://github.com/settings/developers)
# Callback URL: https://<your-domain>/auth/callback
# Leave unset in development to sign in as a local dev user.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Comma-separated GitHub logins allowed to sign in. Empty means nobody.
ALLOWED_GITHUB_LOGINS=

# Optional: TMDB v3 API key or v4 read token, for taglines and 4K backdrops.
TMDB_API_KEY=
